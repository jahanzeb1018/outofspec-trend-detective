{
  "functions": {
    "api/claude/v1/messages.js": {
      "maxDuration": 60
    },
    "api/forecast.js": {
      "maxDuration": 30,
      "includeFiles": "data/watch.json"
    }
  },
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
